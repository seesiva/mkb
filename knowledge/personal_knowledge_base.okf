├── introspection_and_learning_guide.md  (how to learn from your work)
│
├── proposals/                           (all proposals organized by date/topic)
│   ├── 2026-07_cloud_migration/
│   │   └── proposal_cloud_migration.okf
│   ├── 2026-08_api_gateway/
│   │   └── proposal_api_gateway.okf
│   └── [YYYY-MM_new-topic]/
│       └── proposal_[topic].okf
│
├── projects/                            (all projects organized by date/topic)
│   ├── 2026-07_cloud_migration/
│   │   └── project_cloud_migration.okf
│   ├── 2026-08_api_gateway/
│   │   └── project_api_gateway.okf
│   └── [YYYY-MM_new-topic]/
│       └── project_[topic].okf
│
└── learnings/                           (quarterly & annual summaries)
    ├── Q3_2026_learnings.md
    ├── Q4_2026_learnings.md
    └── 2026_annual_retrospective.md
```

